# Public URL of the site, no trailing slash (metadata, sitemap, Stripe return links)
NEXT_PUBLIC_SITE_URL=https://18kintelligence.com
# Shown in the footer and privacy page. Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Sending address. Must be on 18kintelligence.com, which is set up in Resend.
RESEND_FROM=hello@18kintelligence.com
# Gets sale and waitlist notifications
OWNER_EMAIL=
# "18K Intelligence list" segment in Resend
RESEND_SEGMENT_ID=b0355f3b-d21b-45c9-9bd8-da6f8bb1a247
# Download link for the free Creator-Builder Starter Kit (Google Drive, Notion, Dropbox…)
KIT_URL=

# Stripe (https://dashboard.stripe.com/apikeys) — start with test keys (sk_test_…)
STRIPE_SECRET_KEY=
# From the webhook endpoint pointing at https://<your-domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Access link emailed after purchase, one per product (and set live: true in src/content.ts)
ACCESS_URL_FILM_IT_YOURSELF=
ACCESS_URL_BUILD_WITH_AI=
ACCESS_URL_CONTENT_OS=

# Cal.com paid event for the 60-minute call, e.g. https://cal.com/18kintelligence/strategy-call
CAL_CONSULT_URL=

# Meta Pixel: the "18K Intelligence website" dataset ID from Events Manager, digits only. Read when
# the site is built, so redeploy after changing it. Leave empty for no Pixel and no cookie question.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API: the server's copy of each Pixel event, and the sales. Events Manager > the dataset >
# Settings > Conversions API > Generate access token. A secret: never NEXT_PUBLIC_. Empty sends nothing from the server.
META_CONVERSIONS_API_TOKEN=
